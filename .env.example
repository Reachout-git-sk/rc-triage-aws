# Local development only. Copy to .env (git-ignored) and replace every value.
# Use letters, digits and '-' only: these values go into connection URLs.
# These are never used in AWS; there the passwords live in Secrets Manager.
POSTGRES_PASSWORD=replace-me-local-admin
APP_DB_PASSWORD=replace-me-local-app
DQ_DB_PASSWORD=replace-me-local-dq
INGEST_API_KEY=replace-me-local-key
